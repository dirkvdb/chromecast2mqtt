# Docker --env-file example. The binary does not load .env automatically.
# Copy to .env, customize locally, and never commit credentials/private keys.
C2M_MQTT_ADDRESS=mqtt.lan
C2M_MQTT_PORT=8883
C2M_CLIENT_ID=chromecast2mqtt
C2M_MQTT_BASE_TOPIC=chromecast
C2M_MQTT_USER=iot

# MQTT defaults to plaintext. TLS does not change the port: choose 8883 explicitly.
C2M_MQTT_TLS=true
C2M_MQTT_INSECURE=false
# A custom CA enables verified TLS using these roots instead of system roots.
# C2M_MQTT_CA_CERT=/certs/ca.pem
# mTLS: provide BOTH files; this also enables TLS. Mount read-only, UID 10001 readable.
# C2M_MQTT_CLIENT_CERT=/certs/client.pem
# C2M_MQTT_CLIENT_KEY=/certs/client.key
# Insecure mode disables broker identity validation; never combine it with a CA file.

# An explicit INI file is optional; otherwise config.ini in the working directory
# is loaded when present. CLI/env values override legacy INI values.
# C2M_CONFIG=/config/config.ini
C2M_NO_DISCOVERY=false
# IP socket addresses only; comma-separated entries preserve spaces in names.
# C2M_DEVICES=Living Room=192.0.2.10:8009,Bedroom=[2001:db8::10]:8009
