 use byteorder::{BigEndian, ReadBytesExt, WriteBytesExt};
 use std::io::Cursor;
 
+/// Adds the JSON field path while retaining the existing serialization error variant.
+pub(crate) fn deserialize_reply<T: serde::de::DeserializeOwned>(
+    reply: serde_json::Value,
+) -> Result<T, Error> {
+    serde_path_to_error::deserialize(reply).map_err(|error| {
+        Error::Serialization(<serde_json::Error as serde::de::Error>::custom(error))
+    })
+}
+
 pub fn read_u32_from_buffer(buffer: &[u8]) -> Result<u32, Error> {
     Ok(Cursor::new(buffer).read_u32::<BigEndian>()?)
 }
